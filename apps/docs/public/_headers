# Cloudflare Pages reads this from the top of the build output.
#
# Content-Type is deliberately absent: Pages types these from the file
# extension and appends a charset, which setting the header here would drop.

/r/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=0, must-revalidate

/tokens.css
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=0, must-revalidate

/tokens.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=0, must-revalidate

/llms.txt
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=0, must-revalidate

/elements/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=0, must-revalidate

# The share video and its poster, rendered by `pnpm og:video`. The names are not fingerprinted, so a
# rerender keeps its URL: a day fresh, then a week served stale while it revalidates, not immutable.
/og/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Vite fingerprints everything here, so a changed byte is a changed URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/guides/*.md
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=0, must-revalidate
