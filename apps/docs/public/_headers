# Cloudflare Pages reads this from the top of the build output.
#
# Content-Type is deliberately absent: Pages types these from the file
# extension and appends a charset, which setting the header here would drop.

/r/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=0, must-revalidate

/tokens.css
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=0, must-revalidate

/tokens.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=0, must-revalidate

/llms.txt
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=0, must-revalidate

# Vite fingerprints everything here, so a changed byte is a changed URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
