          "paths": [
            "packages/ui/src/dialog.tsx",
            "apps/docs/src/content/components/dialog.mdx",
            "packages/ui/src/__tests__/dialog.test.tsx",
            "apps/docs/src/demos/dialog"
          ]
        }
      ],
      "sources": [
        "packages/ui/src/dialog.tsx"
