    "scripts": {
      "ultima-monorepo": {
        "dev": "pnpm --filter @ultima/docs dev",
        "build": "pnpm -r build",
        "test": "pnpm -r test",
        "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
        "registry:build": "pnpm --filter @ultima/tokens build && pnpm --filter @ultima/elements build && node --experimental-strip-types scripts/build-registry.ts"
      },
      "@ultima/tokens": {
        "build": "node --experimental-strip-types scripts/build-tokens.ts",
        "test": "vitest run --reporter=verbose",
        "typecheck": "tsc -p tsconfig.json"
      },
      "@ultima/ui": {
        "build": "echo \"@ultima/ui: source-only, compiled by the consumer\"",
        "test": "vitest run --reporter=verbose",
        "typecheck": "tsc -p tsconfig.json"
      },
      "@ultima/elements": {
        "build": "node --experimental-strip-types scripts/build.ts",
        "test": "pnpm --filter @ultima/tokens build && pnpm build && vitest run --reporter=verbose",
        "typecheck": "tsc -p tsconfig.json"
      },
      "ultima-design": {
        "build": "node --experimental-strip-types scripts/build.ts",
        "test": "pnpm build && vitest run --reporter=verbose",
        "typecheck": "tsc -p tsconfig.json"
      },
      "@ultima/docs": {
        "dev": "vite",
        "build": "pnpm -w run registry:build && vite build",
        "preview": "vite preview",
        "test": "pnpm -w run registry:build && vitest run --reporter=verbose",
        "typecheck": "tsc -p tsconfig.json"
      }
    },
    "workflows": {
      "ci.yml": {
        "sha256": "a08b7902a6173cdc8ff2500579e03b82902defcb3cafd223c26db2285b6bdcac",
        "timeouts": [
          20
        ],
        "text": "name: CI\n\non:\n  pull_request:\n  push:\n    branches:\n      - main\n\nconcurrency:\n  group: ${{ github.workflow }}-${{ github.ref }}\n  cancel-in-progress: true\n\njobs:\n  check:\n    runs-on: ubuntu-latest\n    timeout-minutes: 20\n    steps:\n      - uses: actions/checkout@v5\n\n      - uses: pnpm/action-setup@v4\n\n      - uses: actions/setup-node@v5\n        with:\n          node-version: 22\n          cache: pnpm\n\n      - name: Install\n        run: pnpm install --frozen-lockfile\n\n      - name: Typecheck\n        run: pnpm typecheck\n\n      - name: Test\n        run: |\n          pnpm --filter @ultima/ui exec playwright install --with-deps chromium\n          pnpm test\n\n      - name: Contrast gate\n        run: python3 packages/tokens/scripts/palette.py --check\n\n      - name: Registry build\n        run: pnpm registry:build\n\n      - name: Docs build\n        run: pnpm --filter @ultima/docs build\n"
      },
      "smoke-install.yml": {
        "sha256": "b23d6f59d0b9dff3dabc7a90a0ba62f179f3d1e9e745192576da9cb199bd00fe",
        "timeouts": [
          45
        ],
        "text": "name: Smoke install\n\non:\n  schedule:\n    - cron: '17 6 * * 1'\n  workflow_dispatch:\n  pull_request:\n    paths:\n      - 'registry/static/**'\n      - 'registry/items.config.ts'\n      - 'scripts/build-registry.ts'\n      - 'scripts/build-agent-guide.ts'\n      - 'scripts/smoke-install.sh'\n      - 'packages/ui/src/**'\n      - 'packages/tokens/**'\n      - '**/package.json'\n      - 'pnpm-workspace.yaml'\n      - 'pnpm-lock.yaml'\n      - '.github/workflows/smoke-install.yml'\n\njobs:\n  smoke-install:\n    runs-on: ubuntu-latest\n    timeout-minutes: 45\n    steps:\n      - uses: actions/checkout@v5\n\n      - uses: pnpm/action-setup@v4\n\n      - uses: actions/setup-node@v5\n        with:\n          node-version: 22\n          cache: pnpm\n\n      - run: pnpm install --frozen-lockfile\n\n      # mktemp honours TMPDIR, so the consumer apps land somewhere the upload\n      # step can name.\n      - name: Smoke install\n        run: |\n          mkdir -p \"$RUNNER_TEMP/smoke\"\n          TMPDIR=\"$RUNNER_TEMP/smoke\" ./scripts/smoke-install.sh --keep\n\n      - if: failure()\n        uses: actions/upload-artifact@v4\n        with:\n          name: smoke-install-apps\n          path: |\n            ${{ runner.temp }}/smoke\n            !${{ runner.temp }}/smoke/**/node_modules/**\n          retention-days: 7\n"
      }
    },
