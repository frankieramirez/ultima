                      "name": "Paragraph",
                      "fill": "$ult-color-text-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "It would also have carried two styling models, two token sources and two sets of conventions for an agent to learn. One engine means one model to document.",
                      "lineHeight": 1.7,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 16.5,
                      "fontWeight": "normal"
