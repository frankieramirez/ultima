                    {
                      "type": "text",
                      "id": "JEJJA",
                      "name": "Wrap a table wider than its column in Ta",
                      "context": "MDXContent - p",
                      "fill": "$ult-color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Wrap a table wider than its column in Table.Scroll. It is a focusable region, so a keyboard user reaches the overflow and scrolls it with the arrow keys, and it takes its name from the caption through aria-labelledby. A table that fits needs no region and should omit it. The minimum width goes through the style slot on Table.Root.",
                      "lineHeight": 1.55,
