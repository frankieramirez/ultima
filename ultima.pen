                      "name": "pre",
                      "context": "Code - pre",
                      "width": "fill_container",
                      "fill": "#1B1B1B",
                      "stroke": "#3A3A3A",
                      "strokeWidth": 1,
                      "strokeAlignment": "inner",
                      "layout": "vertical",
                      "padding": 20,
                      "children": [
                        {
                          "type": "text",
                          "id": "GCaeV",
                          "name": "@layer reset { *, *::before, *::after { ",
                          "context": "code",
                          "fill": "#F0F0EE",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "@layer reset {\n  *,\n  *::before,\n  *::after {\n    box-sizing: border-box;\n  }\n\n  body {\n    margin: 0;\n  }\n}\n",
                          "lineHeight": 1.55,
                          "fontFamily": "IBM Plex Mono",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]
