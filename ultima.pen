                        {
                          "type": "text",
                          "id": "o6J7g",
                          "name": "The WCAG 2.2 ratios are the build gate: ",
                          "context": "Note - p",
                          "fill": "$ult-color-text-muted",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "The WCAG 2.2 ratios are the build gate: the tokens package refuses to write an export where any of them falls under its minimum. The APCA figures beside them are advice, computed in your browser and never able to fail a build. Lc is shown as a magnitude; its sign only records which of the pair is lighter.",
                          "lineHeight": 1.55,
                          "fontFamily": "$ult-font-sans",
                          "fontSize": 14,
                          "fontWeight": "normal"
