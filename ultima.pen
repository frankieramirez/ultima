                      "fill": "$ult-color-text-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Tailwind was the obvious other path. The author works in it daily, and shadcn's registry and most public libraries assume it. A mixed system would have felt familiar to shadcn users.",
                      "lineHeight": 1.7,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 16.5,
                      "fontWeight": "normal"
                    },
