                      "name": "Paragraph",
                      "fill": "$ult-color-text-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "An npm package would have given an upgrade path and a version number. It would also have kept the source behind a dependency, which fights the point of handing code to a coding agent to edit.",
                      "lineHeight": 1.7,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 16.5,
                      "fontWeight": "normal"
                    },
