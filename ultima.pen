            },
            {
              "type": "frame",
              "id": "OHvhj",
              "name": "div",
              "context": "div",
              "width": "fill_container",
              "gap": 40,
              "padding": [
                40,
                64,
                64,
                56
              ],
              "children": [
                {
                  "type": "frame",
                  "id": "cF8xy",
                  "name": "article",
                  "context": "Prose - article",
                  "width": "fill_container",
                  "layout": "vertical",
                  "children": [
                    {
                      "type": "text",
                      "id": "p3gyYr",
                      "name": "Documentation breadcrumb",
                      "fill": "$ult-color-accent-text",
                      "content": "::root / --rationale",
                      "fontFamily": "$ult-font-mono",
                      "fontSize": 12,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "cp6Cu",
                      "name": "Breadcrumb spacing",
                      "width": "fill_container",
                      "height": 24
                    },
                    {
                      "type": "text",
                      "id": "LIsfZ",
                      "name": "Rationale",
                      "context": "H1 - h1",
                      "fill": "$ult-color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Rationale",
                      "lineHeight": 1.2,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 56,
                      "fontWeight": "500",
                      "letterSpacing": -1.5
                    },
                    {
                      "type": "frame",
                      "id": "ANP4e",
                      "name": "spacer",
                      "width": "fill_container",
                      "height": 16,
                      "layout": "none"
                    },
                    {
                      "type": "text",
                      "id": "LfY3t",
                      "name": "The choices that decide how Ultima is bu",
                      "context": "MDXContent - p",
                      "fill": "$ult-color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The choices that decide how Ultima is built. Each one had alternatives on the table. The ADRs record the verdict; this page is the reading version.",
                      "lineHeight": 1.55,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "D3pFIX",
                      "name": "spacer",
                      "width": "fill_container",
                      "height": 32,
                      "layout": "none"
                    },
                    {
                      "type": "text",
                      "id": "J3hVCL",
                      "name": "StyleX",
                      "context": "H2 - h2",
                      "fill": "$ult-color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "StyleX",
                      "lineHeight": 1.2,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 26,
                      "fontWeight": "500",
                      "letterSpacing": -0.4
                    },
                    {
                      "type": "frame",
                      "id": "y0saR",
                      "name": "spacer",
                      "width": "fill_container",
                      "height": 12,
                      "layout": "none"
                    },
                    {
                      "type": "text",
                      "id": "y0zM5z",
                      "name": "ADR 0001. Components are authored in Sty",
                      "context": "MDXContent - p",
                      "fill": "$ult-color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "ADR 0001. Components are authored in StyleX. Tokens are StyleX variables. A build step emits the same tokens as CSS custom properties for consumers that cannot run StyleX.",
                      "lineHeight": 1.55,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "x9WnP",
                      "name": "spacer",
                      "width": "fill_container",
                      "height": 12.01,
                      "layout": "none"
                    },
                    {
                      "type": "text",
                      "id": "EVO6S",
                      "name": "Tailwind was the obvious other path. The",
                      "context": "MDXContent - p",
                      "fill": "$ult-color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Tailwind was the obvious other path. The author works in it daily, and shadcn's registry plus most public libraries assume it. A mixed system (StyleX components with a Tailwind escape hatch) would have felt familiar to shadcn users. It would also have carried two styling models, two token sources, and two sets of conventions for an agent to learn.",
                      "lineHeight": 1.55,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "glOcy",
                      "name": "spacer",
                      "width": "fill_container",
                      "height": 11.99,
                      "layout": "none"
                    },
                    {
                      "type": "text",
                      "id": "vgpbo",
                      "name": "One engine means one model to document. ",
                      "context": "MDXContent - p",
                      "fill": "$ult-color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "One engine means one model to document. The cost is a StyleX compiler plugin in the consumer's bundler, which the setup item installs or explains. Tailwind-only projects can take the tokens CSS export. They cannot take the components.",
                      "lineHeight": 1.55,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "XrP19",
                      "name": "spacer",
                      "width": "fill_container",
                      "height": 32,
                      "layout": "none"
                    },
                    {
                      "type": "text",
                      "id": "lH8VW",
                      "name": "Base UI",
                      "context": "H2 - h2",
                      "fill": "$ult-color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Base UI",
                      "lineHeight": 1.2,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 26,
                      "fontWeight": "500",
                      "letterSpacing": -0.4
                    },
                    {
                      "type": "frame",
                      "id": "zntMB",
                      "name": "spacer",
                      "width": "fill_container",
                      "height": 12,
                      "layout": "none"
                    },
                    {
                      "type": "text",
                      "id": "M7e0hP",
                      "name": "ADR 0002. Every interactive component is",
                      "context": "MDXContent - p",
                      "fill": "$ult-color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "ADR 0002. Every interactive component is built on Base UI. Radix is out of scope.",
                      "lineHeight": 1.55,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "T62Jw",
                      "name": "spacer",
                      "width": "fill_container",
                      "height": 12.01,
                      "layout": "none"
                    },
                    {
                      "type": "text",
                      "id": "ZBlaA",
                      "name": "Interactive pieces need accessible, unst",
                      "context": "MDXContent - p",
                      "fill": "$ult-color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Interactive pieces need accessible, unstyled primitives for focus, keyboard behavior, and ARIA. Radix is the shadcn default. Base UI is the MUI-backed library shadcn/ui and others are moving toward, and it is the primitive named in the work Ultima is modeled on.",
                      "lineHeight": 1.55,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "rxDiT",
                      "name": "spacer",
                      "width": "fill_container",
                      "height": 12,
                      "layout": "none"
                    },
                    {
                      "type": "text",
                      "id": "OtESd",
                      "name": "One primitive vocabulary. v0's component",
                      "context": "MDXContent - p",
                      "fill": "$ult-color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "One primitive vocabulary. v0's component list is bounded by what Base UI ships. Styling hooks have to compose with StyleX-generated props, which the Button and Card prototype verified before authoring conventions locked.",
                      "lineHeight": 1.55,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "twFAL",
                      "name": "spacer",
                      "width": "fill_container",
                      "height": 32,
                      "layout": "none"
                    },
                    {
                      "type": "text",
                      "id": "U4Orw",
                      "name": "Registry-first",
                      "context": "H2 - h2",
                      "fill": "$ult-color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Registry-first",
                      "lineHeight": 1.2,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 26,
                      "fontWeight": "500",
                      "letterSpacing": -0.4
                    },
                    {
                      "type": "frame",
                      "id": "Yr60b",
                      "name": "spacer",
                      "width": "fill_container",
                      "height": 12,
                      "layout": "none"
                    },
                    {
                      "type": "text",
                      "id": "YmYCi",
                      "name": "ADR 0003. Consumers install from Ultima'",
                      "context": "MDXContent - p",
                      "fill": "$ult-color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "ADR 0003. Consumers install from Ultima's hosted registry with the shadcn CLI and own the installed code. A published npm package for tokens waits until a consumer needs it.",
                      "lineHeight": 1.55,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "Y57Mxz",
                      "name": "spacer",
                      "width": "fill_container",
                      "height": 12.01,
                      "layout": "none"
                    },
                    {
                      "type": "text",
                      "id": "clSRD",
                      "name": "The other options were an npm package, a",
                      "context": "MDXContent - p",
                      "fill": "$ult-color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The other options were an npm package, a copy-source registry, or both. An npm package would have given an upgrade path and a version number. It would also have kept the source behind a dependency, which fights the point of handing code to a coding agent to edit.",
                      "lineHeight": 1.55,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "VI6cC",
                      "name": "spacer",
                      "width": "fill_container",
                      "height": 12,
                      "layout": "none"
                    },
                    {
                      "type": "text",
                      "id": "elmB6",
                      "name": "There is no upgrade path beyond re-insta",
                      "context": "MDXContent - p",
                      "fill": "$ult-color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "There is no upgrade path beyond re-installing an item. Versioning policy for a copy-source registry is still open. Hosting the registry is why the docs site is a v0 deliverable.",
                      "lineHeight": 1.55,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "a8GToS",
                      "name": "spacer",
                      "width": "fill_container",
                      "height": 12,
                      "layout": "none"
                    },
                    {
                      "type": "text",
                      "id": "V7ex2",
                      "name": "npx shadcn init is not the entry. init r",
                      "context": "MDXContent - p",
                      "fill": "$ult-color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "npx shadcn init is not the entry. init refuses a project without Tailwind on disk. The command is npx shadcn add of a per-target setup item. The decision in the ADR stands; only the command changed.",
                      "lineHeight": 1.55,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "qwjtT",
                      "name": "spacer",
                      "width": "fill_container",
                      "height": 32,
                      "layout": "none"
                    },
                    {
                      "type": "text",
                      "id": "P4ZO1",
                      "name": "Dark-first",
                      "context": "H2 - h2",
                      "fill": "$ult-color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Dark-first",
                      "lineHeight": 1.2,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 26,
                      "fontWeight": "500",
                      "letterSpacing": -0.4
                    },
                    {
                      "type": "frame",
                      "id": "soF2P",
                      "name": "spacer",
                      "width": "fill_container",
                      "height": 12,
                      "layout": "none"
                    },
                    {
                      "type": "text",
                      "id": "HwrLz",
                      "name": "Dark is the default and the design targe",
                      "context": "MDXContent - p",
                      "fill": "$ult-color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Dark is the default and the design target. Light is a full peer: every semantic token, every contrast check, and every demo exists in both modes.",
                      "lineHeight": 1.55,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "enw1v",
                      "name": "spacer",
                      "width": "fill_container",
                      "height": 12,
                      "layout": "none"
                    },
                    {
                      "type": "text",
                      "id": "KGNqb",
                      "name": "The alternatives were light-first (the u",
                      "context": "MDXContent - p",
                      "fill": "$ult-color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The alternatives were light-first (the usual default for a new system) and dark-only with light as best effort. Light-first would have made the palette a translation of a light scale, which is how most ramps go wrong in dark. Best-effort light would have shipped pairings that fail AA the first time someone flipped the OS setting.",
                      "lineHeight": 1.55,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "y78ON",
                      "name": "spacer",
                      "width": "fill_container",
                      "height": 12,
                      "layout": "none"
                    },
                    {
                      "type": "text",
                      "id": "pSvjn",
                      "name": "Dark values are the default on every col",
                      "context": "MDXContent - p",
                      "fill": "$ult-color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Dark values are the default on every color token. Light values sit under @media (prefers-color-scheme: light). darkTheme and lightTheme force a mode on a subtree. The header control on this site is the demonstration: dark, light, and system, persisted, with native controls following through color-scheme.",
                      "lineHeight": 1.55,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "tlQCN",
                  "name": "On this page",
                  "width": 176,
                  "stroke": "$ult-color-border",
                  "strokeWidth": {
                    "left": 1
                  },
                  "layout": "vertical",
                  "gap": 16,
                  "padding": [
                    8,
                    0,
