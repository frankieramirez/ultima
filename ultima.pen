                          "width": "fill_container",
                          "content": "npx shadcn add https://ultima.systems/r/setup-next.json\nnpx shadcn add @ultima/button\n",
                          "lineHeight": 1.55,
                          "fontFamily": "IBM Plex Mono",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "Ll7er",
                      "name": "spacer",
                      "width": "fill_container",
