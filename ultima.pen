                      "name": "Ultima ships as a shadcn-compatible regi",
                      "context": "MDXContent - p",
                      "fill": "#F0F0EE",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Ultima ships as a shadcn-compatible registry. You copy source into your project with the CLI and own it after that.",
                      "lineHeight": 1.55,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "eHqdX",
                      "name": "spacer",
                      "width": "fill_container",
                      "height": 12,
                      "layout": "none"
                    },
                    {
                      "type": "text",
                      "id": "zUuUl",
                      "name": "npx shadcn init is not supported. Its pr",
                      "context": "MDXContent - p",
                      "fill": "#F0F0EE",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "npx shadcn init is not supported. Its preflight requires Tailwind on disk, and Ultima does not use Tailwind. The entry is a per-target setup item, which is a universal registry:item and installs into a project that has no components.json yet.",
                      "lineHeight": 1.55,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
