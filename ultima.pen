                        {
                          "type": "text",
                          "id": "Etaav",
                          "name": "A token is a custom property with the na",
                          "context": "Note - p",
                          "fill": "$ult-color-text-muted",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "A token is a custom property with the name you see above, so a consumer that reads the CSS export re-skins with plain CSS on the root. A consumer compiling with StyleX gets the same result from createTheme, which returns a class to put on any subtree.",
                          "lineHeight": 1.55,
                          "fontFamily": "$ult-font-sans",
                          "fontSize": 14,
                          "fontWeight": "normal"
