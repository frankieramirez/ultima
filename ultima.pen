                      "width": "fill_container",
                      "height": 16,
                      "layout": "none"
                    },
                    {
                      "type": "text",
                      "id": "yKjfc",
                      "name": "Ultima ships as a shadcn-compatible regi",
                      "context": "MDXContent - p",
                      "fill": "$ult-color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Ultima ships as a shadcn-compatible registry. You copy source into your project with the CLI and own it after that.",
                      "lineHeight": 1.55,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "eHqdX",
                      "name": "spacer",
                      "width": "fill_container",
                      "height": 12,
                      "layout": "none"
                    },
                    {
                      "type": "text",
                      "id": "zUuUl",
                      "name": "npx shadcn init is not supported. Its pr",
                      "context": "MDXContent - p",
                      "fill": "$ult-color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "npx shadcn init is not supported. Its preflight requires Tailwind on disk, and Ultima does not use Tailwind. The entry is a per-target setup item, which is a universal registry:item and installs into a project that has no components.json yet.",
                      "lineHeight": 1.55,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "Dcen2",
                      "name": "spacer",
                      "width": "fill_container",
                      "height": 32.01,
                      "layout": "none"
                    },
                    {
                      "type": "text",
                      "id": "Erhwn",
                      "name": "Commands",
                      "context": "H2 - h2",
                      "fill": "$ult-color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Commands",
                      "lineHeight": 1.2,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 26,
                      "fontWeight": "500",
                      "letterSpacing": -0.4
                    },
                    {
                      "type": "frame",
                      "id": "CvaaZ",
                      "name": "spacer",
                      "width": "fill_container",
                      "height": 12,
                      "layout": "none"
                    },
                    {
                      "type": "text",
                      "id": "pPlKk",
