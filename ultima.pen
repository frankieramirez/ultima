                    },
                    {
                      "type": "text",
                      "id": "HPkqs",
                      "name": "Components need a StyleX compiler. Token",
                      "context": "MDXContent - p",
                      "fill": "$ult-color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Components need a StyleX compiler. Tokens do not.",
                      "lineHeight": 1.55,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "HEHAI",
                      "name": "spacer",
                      "width": "fill_container",
                      "height": 12.01,
                      "layout": "none"
                    },
                    {
                      "type": "text",
                      "id": "YJANc",
                      "name": "The stable URL is https://ultima.systems",
                      "context": "MDXContent - p",
                      "fill": "$ult-color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The stable URL is https://ultima.systems/tokens.css. Mana's audit report fetches or vendors that file and inlines it. The tokens-css registry item writes the same generated stylesheet to ~/ultima-tokens.css if you want it committed next to your source.",
                      "lineHeight": 1.55,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "JQ1mw",
                      "name": "spacer",
                      "width": "fill_container",
                      "height": 12,
                      "layout": "none"
                    },
                    {
                      "type": "text",
                      "id": "rTG3t",
                      "name": "The export is plain CSS: no @import, no ",
                      "context": "MDXContent - p",
                      "fill": "$ult-color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The export is plain CSS: no @import, no url(), no remote fonts. It follows prefers-color-scheme on :root and also ships [data-theme=\"dark\"] and [data-theme=\"light\"] blocks so you can pin a document to one mode with an attribute on <html>.",
                      "lineHeight": 1.55,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "y48VPv",
                      "name": "spacer",
                      "width": "fill_container",
                      "height": 32,
                      "layout": "none"
                    },
                    {
                      "type": "text",
                      "id": "TsXXO",
                      "name": "For an agent",
                      "context": "H2 - h2",
                      "fill": "$ult-color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "For an agent",
                      "lineHeight": 1.2,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 26,
                      "fontWeight": "500",
                      "letterSpacing": -0.4
                    },
                    {
                      "type": "frame",
                      "id": "e4OIKj",
                      "name": "spacer",
                      "width": "fill_container",
                      "height": 12,
                      "layout": "none"
                    },
                    {
                      "type": "text",
                      "id": "gHj2D",
                      "name": "Point an agent at /llms.txt: the princip",
                      "context": "MDXContent - p",
                      "fill": "$ult-color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Point an agent at /llms.txt: the principles, the conventions, every component's import and props, and the token names, as plain Markdown at one URL. It is generated on every build, and it is the only guidance Ultima publishes for a consumer's repository — nothing documentary is installed into yours.",
                      "lineHeight": 1.55,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
                },
