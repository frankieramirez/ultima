                        17.69,
                        14
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "tjfum",
                          "name": "npx shadcn add https://ultima.systems/r/",
                          "context": "code",
                          "fill": "$ult-color-text",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "npx shadcn add https://ultima.systems/r/setup-next.json\nnpx shadcn add @ultima/button\n",
                          "lineHeight": 1.55,
                          "fontFamily": "$ult-font-mono",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "Ll7er",
                      "name": "spacer",
                      "width": "fill_container",
                      "height": 16,
                      "layout": "none"
                    },
                    {
                      "type": "text",
                      "id": "duOTs",
                      "name": "The first command writes components.json",
                      "context": "MDXContent - p",
                      "fill": "$ult-color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The first command writes components.json and the StyleX compiler config. It also writes the @ultima registry into that file, so the second command resolves through the namespace. You never run shadcn registry add by hand.",
                      "lineHeight": 1.55,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "B2ovP",
                      "name": "spacer",
                      "width": "fill_container",
                      "height": 12,
                      "layout": "none"
                    },
                    {
                      "type": "text",
                      "id": "OWg9c",
                      "name": "Add more components the same way: npx sh",
                      "context": "MDXContent - p",
                      "fill": "$ult-color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Add more components the same way: npx shadcn add @ultima/card. registryDependencies pulls tokens and lib transitively.",
                      "lineHeight": 1.55,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "WlNsc",
                      "name": "spacer",
                      "width": "fill_container",
                      "height": 32,
                      "layout": "none"
                    },
                    {
                      "type": "text",
                      "id": "Y6reo",
                      "name": "What the setup item installs",
                      "context": "H2 - h2",
                      "fill": "$ult-color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "What the setup item installs",
                      "lineHeight": 1.2,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 26,
                      "fontWeight": "500",
                      "letterSpacing": -0.4
                    },
                    {
                      "type": "frame",
                      "id": "QA3I6",
                      "name": "spacer",
                      "width": "fill_container",
                      "height": 12,
                      "layout": "none"
                    },
                    {
                      "type": "text",
                      "id": "M85N1",
                      "name": "A setup item never overwrites a file you",
                      "context": "MDXContent - p",
                      "fill": "$ult-color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "A setup item never overwrites a file your scaffold already owns.",
                      "lineHeight": 1.55,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "aPsAI",
                      "name": "spacer",
                      "width": "fill_container",
                      "height": 12,
                      "layout": "none"
                    },
                    {
                      "type": "text",
                      "id": "IAWqL",
                      "name": "Vite. components.json and ultima.vite.ts",
                      "context": "MDXContent - p",
                      "fill": "$ult-color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Vite. components.json and ultima.vite.ts at the project root. ultima.vite.ts exports ultimaStylex(), the StyleX unplugin with useCSSLayers: true, runtimeInjection: false, the unstable_moduleResolution root, and the @/ alias. You add two lines to your own vite.config.ts: the import, and ultimaStylex() first in plugins. Shipping a vite.config.ts would destroy yours.",
                      "lineHeight": 1.55,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "am6gx",
                      "name": "spacer",
                      "width": "fill_container",
                      "height": 11.99,
                      "layout": "none"
                    },
                    {
                      "type": "text",
                      "id": "Y9QPl",
                      "name": "Next.js App Router. components.json, bab",
                      "context": "MDXContent - p",
                      "fill": "$ult-color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Next.js App Router. components.json, babel.config.js, postcss.config.js, and app/ultima.css (the @stylex; marker). None of those exist in a fresh App Router app, so nothing is clobbered. Turbopack finds the Babel config on its own.",
                      "lineHeight": 1.55,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "FQV2N",
                      "name": "spacer",
                      "width": "fill_container",
                      "height": 12,
                      "layout": "none"
                    },
                    {
                      "type": "text",
                      "id": "jwZN7",
                      "name": "Both components.json files set style: \"b",
                      "context": "MDXContent - p",
                      "fill": "$ult-color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Both components.json files set style: \"base-ultima\" (the base- prefix enables Base UI's render transform), an empty tailwind.config, tailwind.cssVariables: true (false turns on transformCssVars, which rewrites string literals in installed source), flat aliases (@/components/ui, @/lib), and registries[\"@ultima\"]. rsc is true for Next and false for Vite.",
                      "lineHeight": 1.55,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "A9r84",
                      "name": "spacer",
                      "width": "fill_container",
                      "height": 32,
                      "layout": "none"
                    },
                    {
                      "type": "text",
                      "id": "XYoh5",
                      "name": "Steps you still do by hand",
                      "context": "H2 - h2",
                      "fill": "$ult-color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Steps you still do by hand",
                      "lineHeight": 1.2,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 26,
                      "fontWeight": "500",
                      "letterSpacing": -0.4
                    },
                    {
                      "type": "frame",
                      "id": "NUNi2",
                      "name": "spacer",
                      "width": "fill_container",
                      "height": 12,
                      "layout": "none"
                    },
                    {
                      "type": "text",
                      "id": "x13XoP",
                      "name": "The docs field on each setup item prints",
                      "context": "MDXContent - p",
                      "fill": "$ult-color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The docs field on each setup item prints a short list at install. This page is the long form.",
                      "lineHeight": 1.55,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "FXXeQ",
                      "name": "spacer",
                      "width": "fill_container",
                      "height": 12,
                      "layout": "none"
                    },
                    {
                      "type": "text",
                      "id": "LMTiQ",
                      "name": "Vite. Add \"paths\": { \"@/*\": [\"./src/*\"] ",
                      "context": "MDXContent - p",
                      "fill": "$ult-color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Vite. Add \"paths\": { \"@/*\": [\"./src/*\"] } to tsconfig.json and tsconfig.app.json. Without it the CLI writes files into a literal ./@/ directory and reports success. Then add ultimaStylex() to vite.config.ts, before the React plugin.",
                      "lineHeight": 1.55,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "PWpFf",
                      "name": "spacer",
                      "width": "fill_container",
                      "height": 12,
                      "layout": "none"
                    },
                    {
                      "type": "text",
                      "id": "BhXH2",
                      "name": "Next.js. Import ./ultima.css from app/la",
                      "context": "MDXContent - p",
                      "fill": "$ult-color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Next.js. Import ./ultima.css from app/layout.tsx.",
                      "lineHeight": 1.55,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "ivhx3",
                      "name": "spacer",
                      "width": "fill_container",
                      "height": 12,
                      "layout": "none"
                    },
                    {
                      "type": "text",
                      "id": "o7ycYo",
                      "name": "Both. Wrap global resets in an @layer. E",
                      "context": "MDXContent - p",
                      "fill": "$ult-color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Both. Wrap global resets in an @layer. Every StyleX rule sits in a cascade layer, so an unlayered reset such as create-next-app's * { padding: 0 } beats component styles, including a Button's own padding.",
                      "lineHeight": 1.55,
                      "fontFamily": "$ult-font-sans",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "zRcE2",
                      "name": "spacer",
                      "width": "fill_container",
                      "height": 15.99,
                      "layout": "none"
                    },
                    {
                      "type": "frame",
                      "id": "Y5idqI",
                      "name": "pre",
                      "context": "Code - pre",
                      "width": "fill_container",
                      "fill": "$ult-color-surface-sunken",
                      "cornerRadius": "$ult-radius-md",
                      "stroke": "$ult-color-border",
                      "strokeWidth": 2,
                      "strokeAlignment": "inner",
                      "layout": "vertical",
                      "padding": [
                        16,
                        14,
                        17.68,
                        14
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "GCaeV",
                          "name": "@layer reset { *, *::before, *::after { ",
                          "context": "code",
                          "fill": "$ult-color-text",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "@layer reset {\n  *,\n  *::before,\n  *::after {\n    box-sizing: border-box;\n  }\n\n  body {\n    margin: 0;\n  }\n}\n",
                          "lineHeight": 1.55,
                          "fontFamily": "$ult-font-mono",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "KVGXn",
                      "name": "spacer",
                      "width": "fill_container",
