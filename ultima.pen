                                  "fill": "$ult-color-text",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "import { Badge, Table } from '@ultima/ui';\n\nexport default function InTable() {\n  return (\n    <Table.Root>\n      <Table.Caption>Release checks</Table.Caption>\n      <Table.Head>\n        <Table.Row>\n          <Table.HeadCell>Check</Table.HeadCell>\n          <Table.HeadCell>Status</Table.HeadCell>\n        </Table.Row>\n      </Table.Head>\n      <Table.Body>\n        <Table.Row>\n          <Table.Cell>Contrast</Table.Cell>\n          <Table.Cell>\n            <Badge tone=\"success\">Passing</Badge>\n          </Table.Cell>\n        </Table.Row>\n        <Table.Row>\n          <Table.Cell>Bundle</Table.Cell>\n          <Table.Cell>\n            <Badge tone=\"warning\">Review</Badge>\n          </Table.Cell>\n        </Table.Row>\n      </Table.Body>\n    </Table.Root>\n  );\n}\n",
                                  "lineHeight": 1.55,
                                  "fontFamily": "$ult-font-mono",
                                  "fontSize": 14,
                                  "fontWeight": "normal"
                                }
