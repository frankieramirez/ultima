                        {
                          "type": "text",
                          "id": "WoHA8",
                          "name": "This deviates from Radix Colors on purpo",
                          "context": "Note - p",
                          "fill": "#B7B7B7",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "This deviates from Radix Colors on purpose. Ultima's interaction states are palette steps rather than colors derived at runtime, so step 11 is the active fill and the two text steps collapse into 12. The neutral has no solid fills, so its steps 9 to 11 serve as subtle, muted, and ordinary text weights.",
                          "lineHeight": 1.55,
                          "fontFamily": "Geist",
                          "fontSize": 14,
                          "fontWeight": "normal"
