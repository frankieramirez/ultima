              "children": [
                {
                  "type": "frame",
                  "id": "cF8xy",
                  "name": "article",
                  "context": "Documentation reading column: max-width 640px, fluid below that width.",
                  "width": 640,
                  "layout": "vertical",
                  "children": [
                    {
                      "type": "text",
