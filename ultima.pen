                    },
                    {
                      "type": "text",
                      "id": "Upap0",
                      "name": "Paragraph",
                      "fill": "$ult-color-text-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Light-first would have made the palette a translation of a light scale, which is how most ramps go wrong in dark. Best-effort light would have shipped pairings that fail AA the first time someone flipped the OS setting.",
                      "lineHeight": 1.7,
