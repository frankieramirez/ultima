{
  "name": "ultima-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @ultima/docs dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "registry:build": "pnpm --filter @ultima/tokens build && node --experimental-strip-types scripts/build-registry.ts"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "typescript": "^5.9.3"
  }
}
