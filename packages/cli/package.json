{
  "name": "@ultima-systems/cli",
  "version": "0.1.0",
  "description": "Check, diagnose and keep current a project built on the Ultima registry.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frankieramirez/ultima.git",
    "directory": "packages/cli"
  },
  "homepage": "https://ultima.systems",
  "bugs": "https://github.com/frankieramirez/ultima/issues",
  "type": "module",
  "bin": {
    "ultima": "./dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "skill"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "ultima": {
    "registryFormats": {
      "min": 1,
      "max": 1
    }
  },
  "scripts": {
    "build": "node --experimental-strip-types scripts/build.ts",
    "test": "pnpm build && vitest run --reporter=verbose",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "diff": "9.0.0",
    "postcss": "8.5.28",
    "postcss-selector-parser": "7.1.6",
    "prettier": "3.9.8",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@ultima/analysis": "workspace:*",
    "esbuild": "0.28.2",
    "vitest": "^5.0.0"
  }
}
